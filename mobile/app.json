{
  "expo": {
    "name": "MANAS",
    "slug": "manas",
    "scheme": "manas",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.swivelit.manas",
      "versionCode": 6,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FAF6EF"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jeygroups.manas",
      "infoPlist": {
        "NSCameraUsageDescription": "MANAS needs camera access for in-app video sessions.",
        "NSMicrophoneUsageDescription": "MANAS needs microphone access for in-app audio and video sessions."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "androidStatusBar": {
      "backgroundColor": "#FAF6EF",
      "barStyle": "dark-content",
      "translucent": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "./plugins/with-android-gradle-node",
      "./plugins/with-android-kotlin-compat",
      "./plugins/with-android-release-signing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F25BB0"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EF",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-document-picker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9649241407302744~1599761317",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }",
            "kotlinVersion": "2.3.0"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
