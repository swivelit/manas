DATABASE_URL="postgresql://user:password@localhost:5432/manas_db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:8081
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
EMAIL_OTP_DRY_RUN=false
ADMIN_EMAIL=admin@manas.app
ADMIN_PASSWORD=adminpass123
ADMIN_NAME=MANAS Admin
# JaaS is the recommended and production-safe meeting provider.
MEETING_PROVIDER=jaas
MEETING_SERVER_URL=https://8x8.vc
MEETING_APP_ID=
# Short suffix only after the slash; do not set this to appId/kid.
MEETING_JWT_KID=
MEETING_JWT_PRIVATE_KEY= # Include BEGIN and END PEM lines; a single line using \n escapes is accepted.
MEETING_JWT_SECRET=
MEETING_JWT_ALG=RS256
MEETING_TOKEN_TTL_MINUTES=120
MEETING_ENABLE_AUTH=true
MEETING_ALLOW_INSECURE_OPEN_JITSI=false
# Local/demo alternative only; never use anonymous public rooms in production.
# MEETING_PROVIDER=open_jitsi
# MEETING_SERVER_URL=https://meet.jit.si
# MEETING_ENABLE_AUTH=false
CLOUDINARY_URL=
# Alternatively set all three instead of CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
